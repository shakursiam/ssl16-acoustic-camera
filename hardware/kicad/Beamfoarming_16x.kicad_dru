(version 1)

(rule "50ohm_near_pads"
   (constraint clearance (min 0.15mm))
   (condition "(A.hasNetclass('50_ohm') || B.hasNetclass('50_ohm')) && (A.Type == 'Pad' || B.Type == 'Pad')"))

(rule "fine_pitch_footprints"
   (constraint clearance (min 0.12mm))
   (condition "A.memberOfFootprint('U1') || A.memberOfFootprint('U2') || A.memberOfFootprint('U3') || A.memberOfFootprint('U4') || A.memberOfFootprint('U10') || A.memberOfFootprint('J601') || A.memberOfFootprint('J2')"))

(rule "mic_port_hole"
   (constraint hole_clearance (min 0.15mm))
   (condition "A.memberOfFootprint('MK*') || B.memberOfFootprint('MK*')"))